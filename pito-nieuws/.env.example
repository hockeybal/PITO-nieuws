# Voorbeelden; deze file wordt niet automatisch geladen. Geen echte sleutels hier.
# Webservice: /etc/pito-news/web.env
PITO_SITE_MODE=production
PITO_STANDALONE=1
PITO_PUBLIC_URL=https://pitonieuws.nl

# Eén volledige snapshot uit het nieuwe CMS-contenttype PITO Nieuwsartikel.
# HTTPS oorsprong zonder /api; gebruik aparte, beperkte secrets op de server.
PITO_STRAPI_URL=
PITO_NEWS_READ_TOKEN=
# Alleen in newsroom.env, nooit nodig in de publieke webservice:
PITO_NEWS_DRAFT_TOKEN=
# Bronnenregister lezen; aparte sleutel voor eenmalige import, niet in de worker.
PITO_NEWS_SOURCE_TOKEN=
PITO_NEWS_SOURCE_IMPORT_TOKEN=

# Optioneel voor de bestaande lokale worker; CMS-bronnen hebben een eigen reader.
PITO_SOURCE_READER=direct
FIRECRAWL_API_KEY=
PITO_FIRECRAWL_ENABLED=1
# Harde limiet per uitvoering, inclusief het ontdekken van bronlinks.
PITO_FIRECRAWL_MAX_REQUESTS=10

# Complete gedeelde app-snapshot volgens strapi/app-content-contract.example.json
PITO_APP_CONTENT_URL=
PITO_APP_CONTENT_TOKEN=

# Schrijfjob: /etc/pito-news/newsroom.env (alleen server-side, mode 0600)
# Zonder sleutel EN expliciet model worden geen betaalde verzoeken verstuurd.
PITO_WRITER_API_KEY=
PITO_WRITER_MODEL=
# Gebruik xai voor Grok. OpenAI-credentials worden nooit naar xAI gestuurd.
PITO_WRITER_PROVIDER=xai
XAI_API_KEY=
# Bestaande privé-bewijscontrole kan deze lijst gebruiken. Worker --publish is
# geblokkeerd: beoordeling en publicatie gebeuren uitsluitend in Strapi.
PITO_AUTO_PUBLISH_HOSTS=
